<!-- Cartesian printer scene (200 x 200 x 200 mm, Marlin X/Y/Z_BED_SIZE). Toolhead on X carriage, X beam on Y gantry,
     bed on Z. X/Y are force motors driven by the plant peer (motor + belt stiffness); Z follows its step target. Origin = homed 0,0,0. -->
<mujoco model="cartesian-printer">
  <option timestep="0.0005" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient=".35 .35 .35" diffuse=".5 .5 .5"/>
  </visual>
  <!-- Carriages ride on bearings: no geom contacts, so the joints and actuators carry all the dynamics. -->
  <default>
    <geom contype="0" conaffinity="0"/>
  </default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".55 .6 .68" rgb2=".12 .13 .16" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" width="256" height="256" rgb1=".42 .44 .47" rgb2=".36 .38 .41"/>
    <material name="floor" texture="grid" texrepeat="8 8"/>
    <material name="frame" rgba=".15 .15 .17 1"/>
    <material name="rail" rgba=".75 .76 .8 1"/>
    <material name="bed" rgba=".62 .52 .3 1" specular=".4"/>
    <material name="head" rgba=".85 .3 .1 1"/>
  </asset>
  <worldbody>
    <light pos=".1 -.4 .8" dir="0 .5 -1" diffuse=".9 .9 .9" castshadow="true"/>
    <geom type="plane" size="1 1 .01" pos="0 0 -.06" material="floor"/>
    <!-- Frame posts and top rails (Y rails carry the gantry). -->
    <geom type="box" size=".01 .01 .19" pos="-.03 -.03 .13" material="frame"/>
    <geom type="box" size=".01 .01 .19" pos=".23 -.03 .13" material="frame"/>
    <geom type="box" size=".01 .01 .19" pos="-.03 .23 .13" material="frame"/>
    <geom type="box" size=".01 .01 .19" pos=".23 .23 .13" material="frame"/>
    <geom type="box" size=".006 .14 .006" pos="-.03 .1 .3" material="rail"/>
    <geom type="box" size=".006 .14 .006" pos=".23 .1 .3" material="rail"/>
    <geom type="box" size=".15 .14 .01" pos=".1 .1 -.05" material="frame"/>

    <body name="gantry" pos="0 0 .3">
      <joint name="y" type="slide" axis="0 1 0" range="-.01 .21" damping="5"/>
      <geom type="box" size=".14 .008 .008" pos=".1 0 0" material="rail" mass=".6"/>
      <body name="carriage" pos="0 0 0">
        <joint name="x" type="slide" axis="1 0 0" range="-.01 .21" damping="2"/>
        <geom type="box" size=".022 .02 .03" pos="0 0 -.02" material="head" mass=".35"/>
        <geom type="cylinder" size=".004 .012" pos="0 0 -.062" rgba=".8 .7 .2 1" mass=".02"/>
        <site name="nozzle" pos="0 0 -.075" size=".001"/>
      </body>
    </body>

    <!-- Bed: Z+ moves the bed down, so the nozzle-to-bed gap equals Marlin Z. The leadscrew is not
         backdrivable and carries the bed's weight (gravcomp), so the servo only sees inertia. -->
    <body name="bed" pos=".1 .1 .221" gravcomp="1">
      <joint name="z" type="slide" axis="0 0 -1" range="-.01 .21" damping="40"/>
      <geom type="box" size=".11 .11 .004" material="bed" mass="1.2"/>
      <site name="bed_top" pos="-.1 -.1 .004" size=".001"/>
    </body>
  </worldbody>
  <!-- X/Y: force motors; peers/printer_plant.py computes F = k (target - q) + c (d target - dq), the motor and
       belt in series, from datasheet values (see NOMINAL there). Z follows its step target in the peer. -->
  <actuator>
    <motor name="mx" joint="x" gear="1"/>
    <motor name="my" joint="y" gear="1"/>
  </actuator>
</mujoco>
